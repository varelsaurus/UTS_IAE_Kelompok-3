{
  "info": {
    "_postman_id": "api-gateway-collection",
    "name": "Public Transportation Tracker - API Gateway",
    "description": "Postman collection untuk testing API Gateway Bus dan Rute",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "BUSES",
      "item": [
        {
          "name": "Get All Buses",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is an array\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/buses",
              "host": ["{{base_url}}"],
              "path": ["api", "buses"]
            }
          }
        },
        {
          "name": "Get Bus by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has required fields\", function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res).to.have.property('code');",
                  "    pm.expect(res).to.have.property('route_id');",
                  "    pm.expect(res).to.have.property('capacity');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/buses/1",
              "host": ["{{base_url}}"],
              "path": ["api", "buses", "1"]
            }
          }
        },
        {
          "name": "Create Bus",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201 or 200\", function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    pm.environment.set('bus_id', res.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"B-TEST-{{$timestamp}}\",\n  \"route_id\": 1,\n  \"capacity\": 45,\n  \"lat\": -6.2088,\n  \"lng\": 106.8456\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/buses",
              "host": ["{{base_url}}"],
              "path": ["api", "buses"]
            }
          }
        },
        {
          "name": "Update Bus",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"B-UPDATED\",\n  \"route_id\": 1,\n  \"capacity\": 50\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/buses/1",
              "host": ["{{base_url}}"],
              "path": ["api", "buses", "1"]
            }
          }
        },
        {
          "name": "Delete Bus",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/buses/1",
              "host": ["{{base_url}}"],
              "path": ["api", "buses", "1"]
            }
          }
        }
      ]
    },
